{
  "name": "sopheak/sp-laravel-api",
  "description": "Core utilities for Laravel apps: standardized API responses, request ID middleware, and CLI helpers.",
  "type": "library",
  "license": "proprietary",
  "version": "0.5.04",
  "require": {
    "php": "^8.2|^8.3|^8.4|^8.5",
    "intervention/image": "^4.0",
    "laravel/framework": "^12.0|^13.0",
    "nesbot/carbon": "^2.0|^3.0"
  },
  "require-dev": {
    "aws/aws-sdk-php": "^3.0",
    "friendsofphp/php-cs-fixer": "^3.92",
    "larastan/larastan": "^3.0",
    "laravel/ai": "^1.0.1",
    "laravel/mcp": "^1.0.1",
    "league/flysystem-aws-s3-v3": "^3.0",
    "orchestra/testbench": "^10.0|^11.0",
    "phpstan/phpstan": "2.1.32",
    "phpunit/phpunit": "^10.0|^11.0",
    "rector/rector": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Sopheak\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sopheak\\Core\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
    "analyse": "vendor/bin/phpstan analyse src tests",
    "docs:validate": "php bin/validate-docs.php",
    "format": "@rector:fix",
    "format-check": "@rector:check",
    "rector": "vendor/bin/rector process --dry-run",
    "rector:fix": "vendor/bin/rector process",
    "rector:check": "vendor/bin/rector process --dry-run --no-progress-bar",
    "quality": [
      "@format-check",
      "@analyse",
      "@test"
    ]
  },
  "suggest": {
    "aws/aws-sdk-php": "Required for S3/R2 presigned and multipart direct uploads.",
    "laravel/ai": "Required for the AI SDK record tools (PHP 8.3+).",
    "laravel/mcp": "Required for the `laravel` MCP driver (record.mcp.driver = laravel).",
    "league/flysystem-aws-s3-v3": "Required for S3/R2 filesystem disks."
  },
  "extra": {
    "laravel": {
      "providers": [
        "Sopheak\\Core\\CoreSpLaravelApiProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
