# SP Laravel API Package - Environment Configuration Example
# Copy these variables to your Laravel application's .env file

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_username
DB_PASSWORD=your_password

# JWT Configuration (if using JWT authentication)
JWT_SECRET=your_jwt_secret_key_here
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# SP Laravel API Configuration
RECORD_API_PREFIX=api
RECORD_MAX_DEPTH=3
RECORD_CACHE_TTL=3600
RECORD_LAZY_CACHE_TTL=300
RECORD_ENABLE_TENANT_ID=false

# Queue Configuration (optional but recommended)
QUEUE_CONNECTION=database
# For Redis: QUEUE_CONNECTION=redis
# For SQS: QUEUE_CONNECTION=sqs

# Cache Configuration (optional but recommended for performance)
CACHE_DRIVER=file
# For Redis: CACHE_DRIVER=redis
# For Memcached: CACHE_DRIVER=memcached

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Logging Configuration
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Application Configuration
APP_NAME="Your ERP Application"
APP_ENV=local
APP_KEY=base64:your_app_key_here
APP_DEBUG=true
APP_URL=http://localhost

# Mail Configuration (for notifications)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Broadcasting Configuration (for real-time features)
BROADCAST_DRIVER=log
# For Pusher: BROADCAST_DRIVER=pusher
# For Redis: BROADCAST_DRIVER=redis

# Pusher Configuration (if using Pusher for broadcasting)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Redis Configuration (if using Redis)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# AWS Configuration (if using AWS services)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Configuration (for frontend assets)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"